{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/global.css",
  "tailwindAttributes": [
    "contentClassName",
    "contentContainerClassName",
    "imageClassName"
  ],
  "tailwindFunctions": ["clsx", "cn"]
}
