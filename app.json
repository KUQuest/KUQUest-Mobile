{
  "expo": {
    "name": "KUQuest",
    "slug": "KUQUest-Mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/kq-app-icon.png",
    "scheme": "kuquestmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/kq-app-icon.png",
      "bundleIdentifier": "org.kubits.kuquest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#34462F",
        "foregroundImage": "./assets/images/kq-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.kubits.kuquest",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#34462F",
          "image": "./assets/images/kq-start-logo.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#34462F",
            "image": "./assets/images/kq-start-logo.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "th"],
            "android": ["en", "th"]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
