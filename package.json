{
  "name": "kuquest-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "1.6.26",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo/ui": "~57.0.8",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "1.6.26",
    "clsx": "^2.1.1",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.9",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-network": "57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "nativewind": "5.0.0-preview.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "expo-mcp": "~0.2.1",
    "jest": "^29.7.0",
    "jest-expo": "57.0.2",
    "react-test-renderer": "^19.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run update-api-env && expo start",
    "update-api-env": "node ./scripts/update-api-env.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/run-development-build.js android",
    "ios": "expo run:ios",
    "dev:android": "node ./scripts/run-development-build.js android",
    "dev:ios": "node ./scripts/run-development-build.js ios",
    "dev:start": "npm run update-api-env && expo start --dev-client",
    "demo:start": "EXPO_PUBLIC_PROFILE_DEMO=true expo start --dev-client",
    "demo:android:account": "node ./scripts/switch-demo-account.js",
    "build:apk": "eas build --platform android --profile preview",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "private": true,
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest.style-mock.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
