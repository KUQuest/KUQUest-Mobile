{
  "name": "kuquest-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@expo-google-fonts/42dot-sans": "^0.4.0",
    "@expo-google-fonts/be-vietnam-pro": "^0.4.1",
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo/ui": "~57.0.8",
    "@better-auth/expo": "1.6.23",
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "better-auth": "^1.6.25",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.0",
    "@types/bun": "latest",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api:dev": "bun --watch src/index.ts",
    "api:start": "bun src/index.ts",
    "api:lint": "oxlint .",
    "api:lint:fix": "oxlint . --fix",
    "api:typecheck": "tsc --noEmit -p tsconfig.api.json",
    "api:test": "bun test tests",
    "api:build": "bun build src/index.ts --target=bun --outdir=dist",
    "db:generate": "drizzle-kit generate",
    "db:check": "bun scripts/check-migrations.ts",
    "db:seed-admin": "bun scripts/seed-admin.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "api:check": "bun run db:check && bun run api:lint && bun run api:typecheck && bun run api:test && bun run api:build"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest.style-mock.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
